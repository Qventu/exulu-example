# Use Node.js 22.18.0 as specified in package.json. Important, use Debian as
# the ONNX runtime dependencies are not available in Alpine.
FROM node:22.18.0-slim

# Define build argument for NODE_ENV
ARG NODE_ENV=prod
ARG NPM_TOKEN
ARG CACHE_BUSTER_VALUE
RUN echo "Cache bust value: $CACHE_BUSTER_VALUE"

# Echo NODE_ENV for debugging
RUN echo "Building with NODE_ENV: $NODE_ENV"
RUN echo "Building with NPM_TOKEN: $NPM_TOKEN"

# Install Python and system dependencies for docling and the built-in docx skill.
# pandoc, libreoffice, and poppler-utils are required by the docx skill at runtime.
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    tesseract-ocr \
    poppler-utils \
    pandoc \
    libreoffice \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install PM2, tsx, and docx globally for production.
# docx is required at runtime by the built-in docx skill (skill scripts
# require('docx') from the global node_modules).
RUN npm install -g pm2 tsx docx

# Copy package files
COPY package*.json ./

# Copy .npmrc.example first
COPY .npmrc.example ./

# Create .npmrc from .npmrc.example and replace <<PUT_YOUR_TOKEN_HERE>> with the NPM_TOKEN build arg
RUN sed "s/<<PUT_YOUR_TOKEN_HERE>>/${NPM_TOKEN}/g" .npmrc.example > .npmrc

# Verify .npmrc is created and show its contents
RUN cat .npmrc
RUN ls -la .npmrc

# Copy the start script early
COPY start-backend.sh /app/start-backend.sh
RUN chmod +x /app/start-backend.sh
RUN ls -la /app/start-backend.sh

# Install all dependencies (including dev dependencies for build)
# Ensure .npmrc is in the working directory and readable
ENV HUSKY=0
RUN pwd && ls -la && cat .npmrc && npm ci --ignore-scripts

# Copy source code
COPY . .

# Build TypeScript for production
RUN if [ "$NODE_ENV" = "prod" ]; then npm run build; fi

# Remove dev dependencies to reduce image size (only in production)
RUN if [ "$NODE_ENV" = "prod" ]; then npm prune --production; fi

# Setup Python virtual environment and install Python dependencies
RUN npx @exulu/backend setup-python

# Expose port
EXPOSE 9001

# Set environment variables
ENV PORT=9001

# Debug: show what's in the working directory
RUN ls -la

# Start the application
CMD ["sh", "start-backend.sh"] 